# Runtime: development | test | demo | production
APP_ENV=development
APP_NAME=Rabta-e-Hayat
APP_VERSION=0.15.0

# Leave empty for ./rabta.db. Docker uses sqlite:////data/rabta.db.
DATABASE_URL=
DEMO_DATE=2026-08-06
DATA_NOTICE=Synthetic demonstration data only
SYNTHETIC_DATA=true
INTELLIGENCE_REFRESH_ENABLED=true
INTELLIGENCE_REFRESH_POLL_SECONDS=5

# Required in production: generate at least 32 unpredictable characters.
SECRET_KEY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=
FORCE_HTTPS=false
AUTO_CREATE_SCHEMA=true

# Demonstration only. Never enable this in production.
RABTA_SHOW_DEMO_LOGINS=0

LOG_LEVEL=INFO
LOG_JSON=false
BACKUP_DIR=./backups

# Governed Qwen assistance. Core decisions never depend on an LLM. Leave the
# key empty for a fully functional, visibly labelled deterministic fallback.
AI_ENABLED=true
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=20000
AI_MAX_QUESTION_CHARS=500
AI_DAILY_TOKEN_BUDGET=250000
AI_DAILY_BUDGET_USD=20
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.20
AI_CACHE_TTL_SECONDS=3600
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_SECONDS=120
AI_FEATURES=command_brief,transfer_rationale,emergency_brief,ask_rabta,forecast_guardian,optimizer_advisor
